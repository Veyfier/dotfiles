{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "endeavouros",
        "color": {
            "1": "white",
            "2": "black",
            "3": "light_black"
        }
    },
    "display": {
        "separator": " -> ",
        "color": {
            "keys": "white",
            "title": "white",
            "output": "white"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "terminal",
        "cpu",
        "gpu",
        {
            "type": "memory",
            "format": "{1} / {2} ({3})"
        }
    ]
}
